     assert(self != NULL);
+#if defined(SCALANATIVE_GC_USE_YIELDPOINT_TRAPS) && !defined(_WIN32)
+    sigset_t sirinMask;
+    int sirinMaskError = pthread_sigmask(SIG_SETMASK, NULL, &sirinMask);
+    atomic_store_explicit(&self->sirinDiagAdmissionBus, sirinMaskError ? -sirinMaskError : sigismember(&sirinMask, SIGBUS), memory_order_relaxed);
